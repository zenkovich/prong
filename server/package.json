{
  "name": "prong-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prong local git engine: runs git for the UI and exposes it over a local HTTP API with progress events.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.46.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
